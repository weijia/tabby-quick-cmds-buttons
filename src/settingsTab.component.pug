h3 QuickCmdBtn

.form-line
    .header
        .title 显示模式
        .description 选择按钮显示方式

    select.form-control(
        [(ngModel)]='config.store.quickCmdBtnPlugin.displayMode',
        (ngModelChange)='config.save()'
    )
        option(*ngFor='let mode of displayModes', [value]='mode.id') {{mode.name}}

.form-line(*ngIf="config.store.quickCmdBtnPlugin.displayMode === 'sidebar'")
    .header
        .title 侧边栏默认折叠
        .description 启动时侧边栏是否折叠

    toggle.ml-1(
        title="侧边栏默认折叠",
        [(ngModel)]='config.store.quickCmdBtnPlugin.sidebarCollapsed',
        (ngModelChange)='config.save()'
    )

.form-line
    .header
        .title 禁用标签页
        .description 禁用按钮的标签页分组

    toggle.ml-1(
        title="禁用标签页",
        [(ngModel)]='config.store.quickCmdBtnPlugin.disableTabs',
        (ngModelChange)='config.save()'
    )

.form-line
    .header
        .title 使用系统主题
        .description 使用系统主题样式

    toggle.ml-1(
        title="使用系统主题",
        [(ngModel)]='config.store.quickCmdBtnPlugin.useSystemTheme',
        (ngModelChange)='config.save()'
    )
